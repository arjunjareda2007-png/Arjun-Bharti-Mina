rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public readable and writable content collections for portfolio CMS
    match /profiles/{document} {
      allow read, write: if true;
    }

    match /siteSettings/{document} {
      allow read, write: if true;
    }

    match /homepage/{document} {
      allow read, write: if true;
    }

    match /songs/{document} {
      allow read, write: if true;
    }

    match /lyrics/{document} {
      allow read, write: if true;
    }

    match /gallery/{document} {
      allow read, write: if true;
    }

    match /videos/{document} {
      allow read, write: if true;
    }

    match /projects/{document} {
      allow read, write: if true;
    }

    match /books/{document} {
      allow read, write: if true;
    }

    match /timeline/{document} {
      allow read, write: if true;
    }

    match /socialLinks/{document} {
      allow read, write: if true;
    }

    match /messages/{document} {
      allow read, write: if true;
    }

    match /analytics/{document} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
